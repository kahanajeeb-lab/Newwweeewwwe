{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['userId', 'name', 'email'])",
        "userId": {
          ".validate": "newData.isString() && newData.val().length === 6"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "email": {
          ".validate": "newData.isString()"
        }
      },
      ".indexOn": ["userId"]
    },
    "requests": {
      "$receiverUid": {
        ".read": "auth != null",
        "$requestId": {
          ".write": "auth != null && (auth.uid === $receiverUid || (newData.child('senderUid').val() === auth.uid && !data.exists()))",
          ".validate": "newData.hasChildren(['senderUid', 'receiverUid', 'status']) && newData.child('receiverUid').val() === $receiverUid"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && (data.child('participants').child(auth.uid).val() === true || !data.exists())",
        ".write": "auth != null && (data.child('participants').child(auth.uid).val() === true || newData.child('participants').child(auth.uid).val() === true)",
        "participants": {
          ".write": "auth != null"
        },
        "messages": {
          "$messageId": {
            ".read": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true",
            ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true && (newData.child('senderId').val() === auth.uid || (data.exists() && data.child('receiverId').val() === auth.uid))"
          }
        }
      }
    }
  }
}
