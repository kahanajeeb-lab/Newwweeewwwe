{
  "rules": {
    "user_ids": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid && $userId.length === 6"
      }
    },
    "users": {
      ".read": "auth != null",
      ".indexOn": ["userId"],
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'hamzakhanradmi637373@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        ".validate": "newData.hasChildren(['userId', 'name', 'email'])",
        "userId": {
          ".validate": "newData.isString() && newData.val().length === 6 && (!data.exists() || data.val() === newData.val())"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "role": {
          ".validate": "newData.val() === 'user' || (data.exists() && data.val() === newData.val()) || auth.token.email === 'hamzakhanradmi637373@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner'"
        },
        "incomingCall": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || newData.child('callerUid').val() === auth.uid || (data.exists() && data.child('callerUid').val() === auth.uid))"
        },
        "blocked": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "user_chats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid === $uid || $chatId.contains(auth.uid))",
          ".validate": "newData.isBoolean() || newData.isString() || newData.hasChildren()"
        }
      }
    },
    "requests": {
      "$receiverUid": {
        ".read": "auth != null && auth.uid === $receiverUid",
        ".indexOn": ["status", "senderUid"],
        "$requestId": {
          ".write": "auth != null && ((!data.exists() && newData.child('senderUid').val() === auth.uid && newData.child('receiverUid').val() === $receiverUid && auth.uid !== $receiverUid) || (data.exists() && auth.uid === $receiverUid))",
          ".validate": "newData.hasChildren(['senderUid', 'receiverUid', 'status']) && newData.child('receiverUid').val() === $receiverUid && (data.exists() || newData.child('status').val() === 'pending')"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && (data.child('participants').child(auth.uid).val() === true || (!data.exists() && $chatId.contains(auth.uid)))",
        ".write": "auth != null && (data.child('participants').child(auth.uid).val() === true || (!data.exists() && $chatId.contains(auth.uid)))",
        "participants": {
          ".write": "auth != null && $chatId.contains(auth.uid)"
        },
        "lastMessage": {
          ".validate": "newData.isString()"
        },
        "lastTimestamp": {
          ".validate": "newData.isNumber()"
        },
        "lastSenderId": {
          ".validate": "newData.val() === auth.uid"
        },
        "activity": {
          "$activityUid": {
            ".read": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true",
            ".write": "auth != null && auth.uid === $activityUid && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true"
          }
        },
        "messages": {
          "$messageId": {
            ".read": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true",
            ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true && ((!data.exists() && newData.child('senderId').val() === auth.uid && newData.child('receiverId').val() !== auth.uid) || (data.exists() && data.child('receiverId').val() === auth.uid && (newData.child('seen').val() === true || newData.child('delivered').val() === true)))",
            ".validate": "newData.hasChildren(['senderId', 'receiverId', 'text', 'timestamp'])"
          }
        }
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || data.child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        "$blockedUid": {
          ".validate": "newData.hasChildren(['uid', 'userId', 'name', 'timestamp']) && newData.child('uid').val() === $blockedUid"
        }
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && (data.child('callerUid').val() === auth.uid || data.child('receiverUid').val() === auth.uid || !data.exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('callerUid').val() === auth.uid) || (data.exists() && (data.child('callerUid').val() === auth.uid || data.child('receiverUid').val() === auth.uid)))",
        "callerCandidates": {
          ".write": "auth != null && data.parent().child('callerUid').val() === auth.uid"
        },
        "receiverCandidates": {
          ".write": "auth != null && data.parent().child('receiverUid').val() === auth.uid"
        }
      }
    },
    "banned_users": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'hamzakhanradmi637373@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "system_announcements": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'hamzakhanradmi637373@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    },
    "app_config": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'hamzakhanradmi637373@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
    }
  }
}
