{
  "appId": "com.example.calculator",
  "appName": "Calculator",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "buildOptions": {
      "keystorePath": "my-upload-key.jks",
      "keystoreAlias": "upload"
    }
  }
}
